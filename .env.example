# ==============================================================================
# SISTEMA DE GESTIÓN IVI — PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copie este archivo como '.env' y complete con los valores de su entorno.
# ==============================================================================

# Entorno general
NODE_ENV=development
APP_PORT=3000

# Base de datos PostgreSQL Local (ivi_db)
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ivi_db
DB_USER=postgres
DB_PASSWORD=tu_contrasena_local_aqui

# Parámetros para Supabase (cuando se sincronice al entorno cloud)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_anonima_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
