# ==============================================================================
# SISTEMA DE GESTIÓN IVI — .gitignore
# ==============================================================================

# 1. Variables de entorno y secretos (CRÍTICO)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
secrets/
credentials/

# 2. Logs y auditorías efímeras
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Dependencias de Node / Paquetes
node_modules/
.pnp
.pnp.js

# 4. Archivos de compilación y empaquetado
dist/
build/
out/
.next/
coverage/

# 5. Respaldos y dumps de bases de datos locales
*.dump
*.bak
*.sql.gz
database/backups/
database/dumps/
database/local_dumps/

# 6. Archivos de configuración de IDEs y Editores
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 7. Basura del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. Directorios de agentes, IA y temporales
.system_generated/
scratch/
.cache/
